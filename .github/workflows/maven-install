job2:
      name: maveninstall
      needs: job1
      runs-on: ubuntu-latest
      steps:
        - uses: actions/checkout@v4
        - name: Set up JDK 17
          uses: actions/setup-java@v3
          with:
            java-version: "17"
            distribution: temurin
            cache: maven
        - name: Build with maven
          run: |
            mvn install --file pom.xml
            ls -lrt
